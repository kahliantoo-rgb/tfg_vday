rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Legacy tenant bypass: docs without companyRef pass docBelongsToAuthTenant /
    // incomingBelongsToAuthTenant. After backfill (npm run backfill:company-ref),
    // remove the `!('companyRef' in ...)` branches in those helpers.

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function userExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function authUserDocId() {
      return request.auth.uid;
    }

    function authUserExists() {
      return exists(/databases/$(database)/documents/users/$(authUserDocId()));
    }

    function authUserRole() {
      return authUserExists()
        ? userDoc(authUserDocId()).data.role
        : '';
    }

    function isSuperAdminUser() {
      return isSignedIn() && authUserRole() == 'superadmin';
    }

    function isAdminUser() {
      return isSignedIn() && authUserRole() == 'admin';
    }

    function isPlatformAdminUser() {
      return isSuperAdminUser() || isAdminUser();
    }

    function isStaffUser() {
      return isSignedIn()
        && authUserRole() in [
          'superadmin', 'admin', 'director', 'manager',
          'account', 'hr', 'payroll',
          'senior_florist', 'florist'
        ];
    }

    function isSeniorFloristUser() {
      return isSignedIn()
        && authUserRole() in ['senior_florist', 'florist'];
    }

    function isManagerUser() {
      return isSignedIn() && authUserRole() == 'manager';
    }

    function isDirectorUser() {
      return isSignedIn() && authUserRole() == 'director';
    }

    function canManageRolePermissionsDoc() {
      return isSuperAdminUser() || isAdminUser() || isDirectorUser();
    }

    function rolePermissionsDocMatchesAuthTenant(docId) {
      return canCrossTenantAccess()
        || (authUserCanonicalCompanyId() != null
            && canonicalCompanyDocId(docId) == authUserCanonicalCompanyId());
    }

    function incomingRolePermissionsBelongsToAuthTenant(docId) {
      return request.resource.data.companyRef != null
        && canonicalCompanyDocId(get(request.resource.data.companyRef).id)
            == canonicalCompanyDocId(docId)
        && (
          canCrossTenantAccess()
          || incomingCompanyMatchesAuthTenant()
        );
    }

    function canManageCreditInvoices() {
      return isSuperAdminUser()
        || isAdminUser()
        || isManagerUser()
        || authUserRole() == 'account';
    }

    function canViewCreditInvoices() {
      return canManageCreditInvoices()
        || authUserRole() in ['senior_florist', 'florist'];
    }

    function canManageStaffProfiles() {
      return isPlatformAdminUser() || isManagerUser();
    }

    function isOperationsStaffUser() {
      return isStaffUser();
    }

    function authUserCompanyRef() {
      return authUserExists()
        ? userDoc(authUserDocId()).data.companyRef
        : null;
    }

    /// Maps legacy typo company doc id to the canonical production id.
    function canonicalCompanyDocId(companyId) {
      return companyId == 'Ic3Dhfby8f35Md0E1vZC'
        ? 'lc3Dhfby8f35Md0E1vZC'
        : companyId;
    }

    function authUserCanonicalCompanyId() {
      return authUserCompanyRef() != null
        ? canonicalCompanyDocId(get(authUserCompanyRef()).id)
        : null;
    }

    /// product_categories doc id is the company id (canonical).
    function companyCategoryDocMatchesAuthTenant(categoryDocId) {
      return authUserCanonicalCompanyId() != null
        && canonicalCompanyDocId(categoryDocId) == authUserCanonicalCompanyId();
    }

    function incomingProductCategoriesBelongsToAuthTenant() {
      return canCrossTenantAccess()
        || !('companyRef' in request.resource.data)
        || (authUserCompanyRef() != null
            && request.resource.data.companyRef == authUserCompanyRef())
        || (
          authUserCanonicalCompanyId() != null
          && request.resource.data.companyRef != null
          && canonicalCompanyDocId(get(request.resource.data.companyRef).id)
              == authUserCanonicalCompanyId()
        );
    }

    /// Only superadmin may access all companies (cross-tenant).
    function canCrossTenantAccess() {
      return isSuperAdminUser();
    }

    /// Existing doc belongs to caller's tenant (requires companyRef after backfill).
    function docCompanyMatchesAuthTenant(docData) {
      return authUserCompanyRef() != null
        && docData.companyRef != null
        && (
          docData.companyRef == authUserCompanyRef()
          || canonicalCompanyDocId(get(docData.companyRef).id)
              == authUserCanonicalCompanyId()
        );
    }

    function docBelongsToAuthTenant(docData) {
      return canCrossTenantAccess()
        || ('companyRef' in docData && docCompanyMatchesAuthTenant(docData));
    }

    /// Write payload targets caller's tenant (requires companyRef).
    function incomingCompanyMatchesAuthTenant() {
      return authUserCompanyRef() != null
        && request.resource.data.companyRef != null
        && (
          request.resource.data.companyRef == authUserCompanyRef()
          || canonicalCompanyDocId(get(request.resource.data.companyRef).id)
              == authUserCanonicalCompanyId()
        );
    }

    function incomingBelongsToAuthTenant() {
      return canCrossTenantAccess()
        || ('companyRef' in request.resource.data
            && incomingCompanyMatchesAuthTenant());
    }

    /// Updates must not re-assign a document to another tenant.
    function tenantUnchangedOnUpdate() {
      return canCrossTenantAccess()
        || !('companyRef' in resource.data)
        || request.resource.data.companyRef == resource.data.companyRef;
    }

    /// Audit logs may store companyId (string) or legacy companyRef.
    function auditLogBelongsToAuthTenant(docData) {
      return canCrossTenantAccess()
        || ('companyId' in docData
            && authUserCompanyId() != null
            && docData.companyId == authUserCompanyId())
        || docBelongsToAuthTenant(docData);
    }

    function isDriverUser() {
      return isSignedIn() && authUserRole() == 'driver';
    }

    function canReadOrders() {
      return isStaffUser() || isDriverUser();
    }

    function isDriverOrderUpdate() {
      return isDriverUser()
        && docBelongsToAuthTenant(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'orderstatus',
          'delivery_time_actual',
          'delivery_proof_url',
          'delivery_proof_urls',
          'delivery_proof_at',
          'partial_delivery_run_count',
          'partial_delivery_runs',
        ]);
    }

    function orderDiscountFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['discount', 'discount_label', 'discount_remark']);
    }

    function isBroadStaffOrderUpdate() {
      return (isPlatformAdminUser() || canManageCreditInvoices())
        && docBelongsToAuthTenant(resource.data)
        && incomingBelongsToAuthTenant()
        && tenantUnchangedOnUpdate();
    }

    function isLegacyCompanyRefAssignment() {
      return isPlatformAdminUser()
        && !('companyRef' in resource.data)
        && 'companyRef' in request.resource.data
        && incomingCompanyMatchesAuthTenant()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['companyRef']);
    }

    function orderItemBelongsToAuthTenant(itemData) {
      return docBelongsToAuthTenant(itemData)
        || (
          !('companyRef' in itemData)
          && 'orderRef' in itemData
          && itemData.orderRef != null
          && docBelongsToAuthTenant(get(itemData.orderRef).data)
        );
    }

    function orderItemIncomingBelongsToAuthTenant(itemData) {
      return incomingBelongsToAuthTenant()
        || (
          !('companyRef' in itemData)
          && 'orderRef' in itemData
          && itemData.orderRef != null
          && docBelongsToAuthTenant(get(itemData.orderRef).data)
        );
    }

    function isLockedPaidOrderPaymentTamper() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.keys().hasAll(['balance_due', 'amount_paid'])
        && resource.data.balance_due == 0
        && resource.data.amount_paid > 0
        && keys.hasAny([
          'amount_paid',
          'balance_due',
          'cash_received',
          'cash_change',
          'paymentType',
        ]);
    }

    function isFloristStaffOrderUpdate() {
      return isSeniorFloristUser()
        && docBelongsToAuthTenant(resource.data)
        && incomingBelongsToAuthTenant()
        && tenantUnchangedOnUpdate()
        && !isLockedPaidOrderPaymentTamper()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'orderstatus',
          'delivery_time_actual',
          'client_name',
          'Order_Id',
          'paymentType',
          'recipient_name',
          'address',
          'delivery_date',
          'orderType',
          'pickup_delivery',
          'totalAmount',
          'total',
          'totalQty',
          'ProductSelection',
          'amount_paid',
          'balance_due',
          'cash_received',
          'cash_change',
          'recipient_phone_number',
          'PostalCode',
          'region',
          'delivery_time_slot',
          'card_message',
          'customer_phone_number',
          'created_time',
          'material_usage_cost',
          'material_cost_snapshot',
          'material_cost_snapshotted_at',
        ]);
    }

    function isStaffDocUpdate() {
      return isPlatformAdminUser()
        && docBelongsToAuthTenant(resource.data)
        && incomingBelongsToAuthTenant()
        && tenantUnchangedOnUpdate();
    }

    function isStaffOrderItemUpdate() {
      return isPlatformAdminUser()
        && orderItemBelongsToAuthTenant(resource.data)
        && orderItemIncomingBelongsToAuthTenant(request.resource.data)
        && tenantUnchangedOnUpdate();
    }

    /// POS checkout / cart: floor staff edit line qty, price, remark.
    function isFloristOrderItemUpdate() {
      return isSeniorFloristUser()
        && orderItemBelongsToAuthTenant(resource.data)
        && orderItemIncomingBelongsToAuthTenant(request.resource.data)
        && tenantUnchangedOnUpdate();
    }

    function isDriverOrderItemUpdate() {
      return isDriverUser()
        && orderItemBelongsToAuthTenant(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['delivered_qty', 'status']);
    }

    /// Product / custom catalog edits (price, photo, active, etc.).
    function isCatalogDocUpdate() {
      return isStaffUser()
        && docBelongsToAuthTenant(resource.data)
        && incomingBelongsToAuthTenant()
        && tenantUnchangedOnUpdate();
    }

    function isCatalogDocDelete() {
      return isStaffUser()
        && docBelongsToAuthTenant(resource.data);
    }

    function targetUserRole(userId) {
      return userDoc(userId).data.role;
    }

    function isProtectedStaffRole(role) {
      return role in ['superadmin', 'admin', 'director', 'manager'];
    }

    function canDeleteStaffProfile(userId) {
      return isSignedIn()
        && userExists(userId)
        && !isSelfUser(userId)
        && (
          isSuperAdminUser()
          || (
            docBelongsToAuthTenant(userDoc(userId).data)
            && (
              (isAdminUser() && !isProtectedStaffRole(targetUserRole(userId)))
              || (isManagerUser() && !isProtectedStaffRole(targetUserRole(userId)))
            )
          )
        );
    }

    function authUserCompanyId() {
      return authUserCompanyRef() != null
        ? get(authUserCompanyRef()).id
        : null;
    }

    function counterDocBelongsToAuthTenant(counterId) {
      return canCrossTenantAccess()
        || counterId.matches('default_.*')
        || (authUserCompanyId() != null
            && counterId.matches('^' + authUserCompanyId() + '_.*'));
    }

    function orderDocData(orderId) {
      return get(/databases/$(database)/documents/orders/$(orderId)).data;
    }

    function staffRegistrationIntentRef() {
      return /databases/$(database)/documents/staff_registration_intents/$(request.auth.token.email);
    }

    function staffRegistrationIntentExists() {
      return exists(staffRegistrationIntentRef());
    }

    function staffRegistrationIntentData() {
      return get(staffRegistrationIntentRef()).data;
    }

    function staffRegistrationIntentMatchesProfile() {
      return staffRegistrationIntentExists()
        && staffRegistrationIntentData().email == request.auth.token.email
        && staffRegistrationIntentData().role == request.resource.data.role
        && request.resource.data.companyRef != null
        && staffRegistrationIntentData().companyRef != null
        && (
          request.resource.data.companyRef == staffRegistrationIntentData().companyRef
          || canonicalCompanyDocId(get(request.resource.data.companyRef).id)
              == canonicalCompanyDocId(get(staffRegistrationIntentData().companyRef).id)
        );
    }

    function registrationIntentWritableByStaff() {
      return canCrossTenantAccess()
        || (canManageStaffProfiles()
            && 'companyRef' in request.resource.data
            && incomingCompanyMatchesAuthTenant());
    }

    function isSelfUser(userId) {
      return isSignedIn()
        && (
          request.auth.uid == userId
          || (userExists(userId)
              && 'uid' in userDoc(userId).data
              && userDoc(userId).data.uid == request.auth.uid)
          || (userExists(userId)
              && 'email' in userDoc(userId).data
              && userDoc(userId).data.email == request.auth.token.email)
        );
    }

    // --- users ---
    match /users/{userId} {
      allow read: if isSignedIn() && (isSelfUser(userId) || isStaffUser());
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in [
          'senior_florist', 'florist', 'driver', 'admin',
          'director', 'manager', 'account', 'hr', 'payroll'
        ]
        && staffRegistrationIntentMatchesProfile();
      allow update: if isSignedIn() && (isSelfUser(userId) || canManageStaffProfiles());
      allow delete: if canDeleteStaffProfile(userId);
    }

    // --- orders (core) ---
    match /orders/{orderId} {
      allow read: if canReadOrders() && docBelongsToAuthTenant(resource.data);
      allow create: if isStaffUser() && incomingBelongsToAuthTenant();
      allow update: if (!orderDiscountFieldsChanged() || isPlatformAdminUser())
        && (
          isBroadStaffOrderUpdate()
          || isLegacyCompanyRefAssignment()
          || isFloristStaffOrderUpdate()
          || isDriverOrderUpdate()
        );
      allow delete: if isPlatformAdminUser();
    }

    match /orders/{parent}/internal_messages/{document} {
      allow read: if canReadOrders()
        && docBelongsToAuthTenant(orderDocData(parent));
      allow create, update: if isOperationsStaffUser()
        && docBelongsToAuthTenant(orderDocData(parent))
        && incomingBelongsToAuthTenant();
      allow delete: if isPlatformAdminUser();
    }

    match /{path=**}/internal_messages/{document} {
      allow read: if canReadOrders();
    }

    // --- order line items ---
    match /Order_item/{itemId} {
      allow read: if canReadOrders() && orderItemBelongsToAuthTenant(resource.data);
      allow create: if isStaffUser() && incomingBelongsToAuthTenant();
      allow update: if isStaffOrderItemUpdate()
        || isFloristOrderItemUpdate()
        || isDriverOrderItemUpdate();
      allow delete: if isPlatformAdminUser();
    }

    // --- catalog ---
    match /product/{document} {
      allow read: if isSignedIn() && docBelongsToAuthTenant(resource.data);
      allow create: if isStaffUser() && incomingBelongsToAuthTenant();
      allow update: if isCatalogDocUpdate();
      allow delete: if isCatalogDocDelete();
    }

    match /materials/{document} {
      allow read: if isSignedIn() && docBelongsToAuthTenant(resource.data);
      allow create: if isStaffUser() && incomingBelongsToAuthTenant();
      allow update: if isCatalogDocUpdate();
      allow delete: if isCatalogDocDelete();
    }

    match /product_categories/{document} {
      allow read: if isSignedIn()
        && isStaffUser()
        && (
          canCrossTenantAccess()
          || companyCategoryDocMatchesAuthTenant(document)
        );
      allow create: if isStaffUser()
        && companyCategoryDocMatchesAuthTenant(document)
        && incomingProductCategoriesBelongsToAuthTenant();
      allow update: if isStaffUser()
        && companyCategoryDocMatchesAuthTenant(document)
        && incomingProductCategoriesBelongsToAuthTenant();
      allow delete: if isPlatformAdminUser()
        && companyCategoryDocMatchesAuthTenant(document);
    }

    match /staff_roles/{document} {
      allow read: if isSignedIn()
        && isStaffUser()
        && (
          canCrossTenantAccess()
          || companyCategoryDocMatchesAuthTenant(document)
        );
      allow create: if isStaffUser()
        && companyCategoryDocMatchesAuthTenant(document)
        && incomingProductCategoriesBelongsToAuthTenant();
      allow update: if isStaffUser()
        && companyCategoryDocMatchesAuthTenant(document)
        && incomingProductCategoriesBelongsToAuthTenant();
      allow delete: if isPlatformAdminUser()
        && companyCategoryDocMatchesAuthTenant(document);
    }

    match /role_permissions/{document} {
      allow read: if isSignedIn()
        && isStaffUser()
        && (
          canCrossTenantAccess()
          || rolePermissionsDocMatchesAuthTenant(document)
        );
      allow create, update: if canManageRolePermissionsDoc()
        && rolePermissionsDocMatchesAuthTenant(document)
        && incomingRolePermissionsBelongsToAuthTenant(document);
      allow delete: if isSuperAdminUser()
        && rolePermissionsDocMatchesAuthTenant(document);
    }

    match /customProduct/{document} {
      allow read: if isSignedIn() && docBelongsToAuthTenant(resource.data);
      allow create: if isStaffUser() && incomingBelongsToAuthTenant();
      allow update: if isCatalogDocUpdate();
      allow delete: if isCatalogDocDelete();
    }

    // --- company ---
    match /Companies/{document} {
      allow read: if isSignedIn()
        || resource.data.is_active == true;
      allow create, delete: if isSignedIn() && isSuperAdminUser();
      allow update: if isSignedIn() && isPlatformAdminUser();
    }

    // --- counters ---
    match /counters/{document} {
      allow read: if isStaffUser();
      allow create, update: if isStaffUser();
      allow delete: if isPlatformAdminUser();
    }

    match /counter/{document} {
      allow read: if (isStaffUser() || isDriverUser())
        && counterDocBelongsToAuthTenant(document);
      allow create, update: if isStaffUser()
        && counterDocBelongsToAuthTenant(document);
      allow delete: if isPlatformAdminUser();
    }

    // --- audit ---
    match /audit_logs/{document} {
      allow read: if isPlatformAdminUser()
        && auditLogBelongsToAuthTenant(resource.data);
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // --- deleted orders archive (admin soft-delete audit trail) ---
    match /deleted_orders/{document} {
      allow read: if isOperationsStaffUser()
        && docBelongsToAuthTenant(resource.data);
      allow create: if isPlatformAdminUser()
        && incomingBelongsToAuthTenant();
      allow update: if isOperationsStaffUser()
        && docBelongsToAuthTenant(resource.data)
        && tenantUnchangedOnUpdate()
        && incomingBelongsToAuthTenant();
      allow delete: if isPlatformAdminUser()
        && docBelongsToAuthTenant(resource.data);
    }

    // --- customer profiles ---
    match /customers/{document} {
      allow read: if (isOperationsStaffUser() || canViewCreditInvoices())
        && docBelongsToAuthTenant(resource.data);
      allow create: if (isOperationsStaffUser() || canManageCreditInvoices())
        && incomingBelongsToAuthTenant();
      allow update: if (isOperationsStaffUser() || canManageCreditInvoices())
        && docBelongsToAuthTenant(resource.data)
        && tenantUnchangedOnUpdate()
        && incomingBelongsToAuthTenant();
      allow delete: if isPlatformAdminUser()
        && docBelongsToAuthTenant(resource.data);
    }

    // --- credit customer invoices ---
    match /invoices/{document} {
      allow read: if canViewCreditInvoices()
        && docBelongsToAuthTenant(resource.data);
      allow create, update: if canManageCreditInvoices()
        && incomingBelongsToAuthTenant()
        && (request.method != 'update'
            || (docBelongsToAuthTenant(resource.data)
                && tenantUnchangedOnUpdate()));
      allow delete: if canManageCreditInvoices()
        && docBelongsToAuthTenant(resource.data);
    }

    // --- staff registration intents (admin pre-provisions signup) ---
    match /staff_registration_intents/{email} {
      allow read: if false;
      allow create, update: if isSignedIn()
        && request.resource.data.email == email
        && request.resource.data.role in [
          'senior_florist', 'florist', 'driver', 'admin',
          'director', 'manager', 'account', 'hr', 'payroll'
        ]
        && registrationIntentWritableByStaff();
      allow delete: if isSuperAdminUser() || canManageStaffProfiles();
    }

    // --- staff in-app notices (order created / driver assigned) ---
    match /staff_notices/{document} {
      function isNoticeRecipient() {
        return isSignedIn()
          && resource.data.recipient_user_ref
            == /databases/$(database)/documents/users/$(authUserDocId());
      }

      allow read: if isNoticeRecipient()
        && docBelongsToAuthTenant(resource.data);
      allow create: if (isOperationsStaffUser() || isPlatformAdminUser())
        && incomingBelongsToAuthTenant();
      allow update: if isNoticeRecipient()
        && docBelongsToAuthTenant(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read_at']);
      allow delete: if isNoticeRecipient()
        && docBelongsToAuthTenant(resource.data);
    }
  }
}
