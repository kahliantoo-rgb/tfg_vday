rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function userExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function authUserDocId() {
      return request.auth.uid;
    }

    function authUserExists() {
      return exists(/databases/$(database)/documents/users/$(authUserDocId()));
    }

    function authUserRole() {
      return authUserExists()
        ? userDoc(authUserDocId()).data.role
        : '';
    }

    function isSuperAdminUser() {
      return isSignedIn() && authUserRole() == 'superadmin';
    }

    function isAdminUser() {
      return isSignedIn() && authUserRole() == 'admin';
    }

    function isPlatformAdminUser() {
      return isSuperAdminUser() || isAdminUser();
    }

    function isStaffUser() {
      return isSignedIn()
        && authUserRole() in [
          'superadmin', 'admin', 'director', 'manager',
          'account', 'hr', 'payroll',
          'senior_florist', 'florist'
        ];
    }

    function isSeniorFloristUser() {
      return isSignedIn()
        && authUserRole() in ['senior_florist', 'florist'];
    }

    function isManagerUser() {
      return isSignedIn() && authUserRole() == 'manager';
    }

    function isDirectorUser() {
      return isSignedIn() && authUserRole() == 'director';
    }

    function canManageCreditInvoices() {
      return isSuperAdminUser()
        || isAdminUser()
        || isManagerUser()
        || authUserRole() == 'account';
    }

    function canViewCreditInvoices() {
      return canManageCreditInvoices()
        || authUserRole() in ['senior_florist', 'florist'];
    }

    function canManageStaffProfiles() {
      return isPlatformAdminUser() || isManagerUser();
    }

    function isOperationsStaffUser() {
      return isStaffUser();
    }

    function authUserCompanyRef() {
      return authUserExists()
        ? userDoc(authUserDocId()).data.companyRef
        : null;
    }

    /// Only superadmin may access all companies (cross-tenant).
    function canCrossTenantAccess() {
      return isSuperAdminUser();
    }

    /// Existing doc belongs to caller's tenant (legacy docs without companyRef still allowed).
    function docBelongsToAuthTenant(docData) {
      return canCrossTenantAccess()
        || !('companyRef' in docData)
        || (authUserCompanyRef() != null
            && docData.companyRef == authUserCompanyRef());
    }

    /// Write payload targets caller's tenant (legacy docs without companyRef still allowed).
    function incomingBelongsToAuthTenant() {
      return canCrossTenantAccess()
        || !('companyRef' in request.resource.data)
        || (authUserCompanyRef() != null
            && request.resource.data.companyRef == authUserCompanyRef());
    }

    /// Updates must not re-assign a document to another tenant.
    function tenantUnchangedOnUpdate() {
      return canCrossTenantAccess()
        || !('companyRef' in resource.data)
        || request.resource.data.companyRef == resource.data.companyRef;
    }

    /// Audit logs may store companyId (string) or legacy companyRef.
    function auditLogBelongsToAuthTenant(docData) {
      return canCrossTenantAccess()
        || (!('companyId' in docData) && !('companyRef' in docData))
        || ('companyId' in docData
            && authUserCompanyRef() != null
            && docData.companyId == authUserCompanyRef().id)
        || docBelongsToAuthTenant(docData);
    }

    function isDriverUser() {
      return isSignedIn() && authUserRole() == 'driver';
    }

    function canReadOrders() {
      return isStaffUser() || isDriverUser();
    }

    function isDriverStatusUpdate() {
      return isDriverUser()
        && docBelongsToAuthTenant(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'orderstatus', 'delivery_time_actual']);
    }

    function isPlatformAdminOrderUpdate() {
      return isPlatformAdminUser()
        && docBelongsToAuthTenant(resource.data)
        && incomingBelongsToAuthTenant()
        && tenantUnchangedOnUpdate();
    }

    function isSeniorFloristOrderUpdate() {
      return isSeniorFloristUser()
        && docBelongsToAuthTenant(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'orderstatus', 'delivery_time_actual']);
    }

    function isCreditFinanceOrderUpdate() {
      return canManageCreditInvoices()
        && docBelongsToAuthTenant(resource.data)
        && incomingBelongsToAuthTenant()
        && tenantUnchangedOnUpdate();
    }

    function isStaffDocUpdate() {
      return isPlatformAdminUser()
        && docBelongsToAuthTenant(resource.data)
        && incomingBelongsToAuthTenant()
        && tenantUnchangedOnUpdate();
    }

    /// Product / custom catalog edits (price, photo, active, etc.).
    function isCatalogDocUpdate() {
      return isStaffUser()
        && docBelongsToAuthTenant(resource.data)
        && incomingBelongsToAuthTenant()
        && tenantUnchangedOnUpdate();
    }

    function authUserCompanyId() {
      return authUserCompanyRef() != null
        ? get(authUserCompanyRef()).id
        : null;
    }

    function counterDocBelongsToAuthTenant(counterId) {
      return canCrossTenantAccess()
        || counterId.matches('default_.*')
        || (authUserCompanyId() != null
            && counterId.matches('^' + authUserCompanyId() + '_.*'));
    }

    function orderDocData(orderId) {
      return get(/databases/$(database)/documents/orders/$(orderId)).data;
    }

    function isSelfUser(userId) {
      return isSignedIn()
        && (
          request.auth.uid == userId
          || (userExists(userId) && userDoc(userId).data.uid == request.auth.uid)
          || (userExists(userId) && userDoc(userId).data.email == request.auth.token.email)
        );
    }

    // --- users ---
    match /users/{userId} {
      allow read: if isSignedIn() && (isSelfUser(userId) || isStaffUser());
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in [
          'senior_florist', 'florist', 'driver', 'admin',
          'director', 'manager', 'account', 'hr', 'payroll'
        ];
      allow update: if isSignedIn() && (isSelfUser(userId) || canManageStaffProfiles());
      allow delete: if isSignedIn() && isPlatformAdminUser();
    }

    // --- orders (core) ---
    match /orders/{orderId} {
      allow read: if canReadOrders() && docBelongsToAuthTenant(resource.data);
      allow create: if isStaffUser() && incomingBelongsToAuthTenant();
      allow update: if isPlatformAdminOrderUpdate()
        || isSeniorFloristOrderUpdate()
        || isCreditFinanceOrderUpdate()
        || isDriverStatusUpdate();
      allow delete: if isPlatformAdminUser();
    }

    match /orders/{parent}/internal_messages/{document} {
      allow read: if canReadOrders()
        && docBelongsToAuthTenant(orderDocData(parent));
      allow create, update: if isOperationsStaffUser()
        && docBelongsToAuthTenant(orderDocData(parent))
        && incomingBelongsToAuthTenant();
      allow delete: if isPlatformAdminUser();
    }

    match /{path=**}/internal_messages/{document} {
      allow read: if canReadOrders();
    }

    // --- order line items ---
    match /Order_item/{itemId} {
      allow read: if canReadOrders() && docBelongsToAuthTenant(resource.data);
      allow create: if isStaffUser() && incomingBelongsToAuthTenant();
      allow update: if isStaffDocUpdate();
      allow delete: if isPlatformAdminUser();
    }

    // --- catalog ---
    match /product/{document} {
      allow read: if isSignedIn() && docBelongsToAuthTenant(resource.data);
      allow create: if isStaffUser() && incomingBelongsToAuthTenant();
      allow update: if isCatalogDocUpdate();
      allow delete: if isPlatformAdminUser();
    }

    match /product_categories/{document} {
      allow read: if isSignedIn() && docBelongsToAuthTenant(resource.data);
      allow create: if isStaffUser() && incomingBelongsToAuthTenant();
      allow update: if isCatalogDocUpdate();
      allow delete: if isPlatformAdminUser();
    }

    match /customProduct/{document} {
      allow read: if isSignedIn() && docBelongsToAuthTenant(resource.data);
      allow create: if isStaffUser() && incomingBelongsToAuthTenant();
      allow update: if isCatalogDocUpdate();
      allow delete: if isPlatformAdminUser();
    }

    // --- company ---
    match /Companies/{document} {
      allow read: if isSignedIn()
        || resource.data.is_active == true;
      allow create, delete: if isSignedIn() && isSuperAdminUser();
      allow update: if isSignedIn() && isPlatformAdminUser();
    }

    // --- counters ---
    match /counters/{document} {
      allow read: if isStaffUser();
      allow create, update: if isStaffUser();
      allow delete: if isPlatformAdminUser();
    }

    match /counter/{document} {
      allow read: if (isStaffUser() || isDriverUser())
        && counterDocBelongsToAuthTenant(document);
      allow create, update: if isStaffUser()
        && counterDocBelongsToAuthTenant(document);
      allow delete: if isPlatformAdminUser();
    }

    // --- audit ---
    match /audit_logs/{document} {
      allow read: if isPlatformAdminUser()
        && auditLogBelongsToAuthTenant(resource.data);
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // --- deleted orders archive (admin soft-delete audit trail) ---
    match /deleted_orders/{document} {
      allow read: if isOperationsStaffUser()
        && docBelongsToAuthTenant(resource.data);
      allow create: if isPlatformAdminUser()
        && incomingBelongsToAuthTenant();
      allow update: if isOperationsStaffUser()
        && docBelongsToAuthTenant(resource.data)
        && tenantUnchangedOnUpdate()
        && incomingBelongsToAuthTenant();
      allow delete: if isPlatformAdminUser()
        && docBelongsToAuthTenant(resource.data);
    }

    // --- customer profiles ---
    match /customers/{document} {
      allow read: if (isOperationsStaffUser() || canViewCreditInvoices())
        && docBelongsToAuthTenant(resource.data);
      allow create: if (isOperationsStaffUser() || canManageCreditInvoices())
        && incomingBelongsToAuthTenant();
      allow update: if (isOperationsStaffUser() || canManageCreditInvoices())
        && docBelongsToAuthTenant(resource.data)
        && tenantUnchangedOnUpdate()
        && incomingBelongsToAuthTenant();
      allow delete: if isPlatformAdminUser()
        && docBelongsToAuthTenant(resource.data);
    }

    // --- credit customer invoices ---
    match /invoices/{document} {
      allow read: if canViewCreditInvoices()
        && docBelongsToAuthTenant(resource.data);
      allow create, update: if canManageCreditInvoices()
        && incomingBelongsToAuthTenant()
        && (request.method != 'update'
            || (docBelongsToAuthTenant(resource.data)
                && tenantUnchangedOnUpdate()));
      allow delete: if canManageCreditInvoices()
        && docBelongsToAuthTenant(resource.data);
    }

    // --- staff in-app notices (order created / driver assigned) ---
    match /staff_notices/{document} {
      function isNoticeRecipient() {
        return isSignedIn()
          && resource.data.recipient_user_ref
            == /databases/$(database)/documents/users/$(authUserDocId());
      }

      allow read: if isNoticeRecipient()
        && docBelongsToAuthTenant(resource.data);
      allow create: if (isOperationsStaffUser() || isPlatformAdminUser())
        && incomingBelongsToAuthTenant();
      allow update: if isNoticeRecipient()
        && docBelongsToAuthTenant(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read_at']);
      allow delete: if false;
    }
  }
}
